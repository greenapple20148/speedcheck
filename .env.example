# ─── Public (browser) ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123
# Public measurement API (required in production — must be https:// when the site uses HTTPS)
NEXT_PUBLIC_SPEEDTEST_URL=http://127.0.0.1:18443
# Vercel/server-only: upstream for /api/measurement proxy (use when you cannot expose CORS to the browser)
# SPEEDTEST_INTERNAL_URL=https://measure.example.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_ENABLE_AFFILIATES=true
NEXT_PUBLIC_PRIVACY_ANALYTICS=false

# ─── Next.js server ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Local dev only; on Vercel defaults to /tmp/speedcheck/results.json if Supabase is unset
RESULTS_STORE_PATH=.data/results.json
ADMIN_DASHBOARD_TOKEN=change-me-admin
SESSION_HASH_SALT=change-me-salt

# ─── AI diagnostics (server-only) ───────────────────────────────
# OPENAI_API_KEY=
# OPENAI_DIAGNOSTICS_MODEL=gpt-4o-mini
# DIAGNOSTICS_AI_ENABLED=true
# NEXT_PUBLIC_FEATURE_AI_DIAGNOSTICS=true
# NEXT_PUBLIC_FEATURE_ISP_REPORT=false
# NEXT_PUBLIC_FEATURE_GAMING_DIAGNOSTICS=false
# NEXT_PUBLIC_FEATURE_WIFI_COMPARE=false

# ─── Go speed test service ──────────────────────────────────────
SPEEDTEST_LISTEN_ADDR=:18443
SPEEDTEST_PUBLIC_URL=http://127.0.0.1:18443
SPEEDTEST_SERVER_ID=local-1
SPEEDTEST_SERVER_NAME=Local Dev
SPEEDTEST_SERVER_REGION=local
SPEEDTEST_SERVER_LOCATION=Development
SPEEDTEST_HMAC_SECRET=dev-hmac-secret-change-in-production
SPEEDTEST_ADMIN_TOKEN=dev-admin-token
SPEEDTEST_CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
SPEEDTEST_MAX_CONCURRENT_TESTS=50
SPEEDTEST_DAILY_BANDWIDTH_GB=500
SPEEDTEST_PER_TEST_BUDGET_MB_LIGHT=20
SPEEDTEST_PER_TEST_BUDGET_MB_STANDARD=80
SPEEDTEST_MAX_DURATION_SEC=20
SPEEDTEST_SESSION_TTL_SEC=120
SPEEDTEST_RATE_LIMIT_PER_IP=30
